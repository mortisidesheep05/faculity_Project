# Server Port (default: 5001)
PORT=5001

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Connection String (Optional for local dev, required for Vercel/production)
# If left empty locally, an In-Memory MongoDB will be automatically started.
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/faculty_portal?retryWrites=true&w=majority

# Frontend API URL (Optional - defaults to /api which works automatically via proxy locally and on Vercel)
# VITE_API_URL=http://localhost:5001/api
